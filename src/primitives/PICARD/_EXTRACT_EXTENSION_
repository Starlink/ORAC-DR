use Starlink::HDSPACK qw/create_hdsobj copy_hdsobj/;

my $extension = get_prim_arg($_PRIM_ARGS_, 'EXTENSION', undef);
my $suffix = get_prim_arg($_PRIM_ARGS_, 'SUFFIX', undef);

orac_termerr('EXTENSION not specified')
    unless defined $extension;

unless (defined $suffix) {
    my @parts = split /\./, $extension;
    $suffix = '_' . lc $parts[-1];
}

my @output = ();

foreach (my $i = 0; $i < $Frm->nfiles(); $i ++) {
    my ($in, $out) = $Frm->inout($suffix, $i + 1);

    $Mon{'ndfpack_mon'}->obeyw('ndfcopy', "in=$in.MORE.$extension out=$out");

    # If there is no FITS extension (i.e. we can create it), copy it.
    create_hdsobj("$out.MORE", "EXT");
    if (create_hdsobj("$out.MORE.FITS", "_CHAR*80")) {
        my $ORAC_STATUS = copy_hdsobj("$in.MORE.FITS", "$out.MORE.FITS") ? ORAC__OK : ORAC__ERROR;
    }

    push @output, $out;
}

$Frm->files(@output);
