my $ard = ORAC::TempFile->new(OPEN => 1, SUFFIX => '.ard');

my $fh = $ard->handle;
print $fh "COFRAME(PIXEL)\n";
print $fh "CIRCLE(15,23,16)\n";
$fh->close;
my $ardfile = $ard->file;

my @output = ();

for (my $i = 1; $i <= $Frm->nfiles(); $i ++) {
    my ($in, $out) = $Frm->inout('_msk', $i);

    $Mon{kappa_mon}->obeyw('ardmask', "$in $ardfile $out inside=false");

    push @output, $out;
}

$Frm->files(@output);
