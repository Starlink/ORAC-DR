for (my $i = 0; $i < $Frm->nfiles(); $i ++) {
    my $in = $Frm->file($i + 1);

    _FIND_IMAGE_STATISTICS_ IMAGE=$in COMP=data VERBOSE=0

    my @headings = qw/Subarray Direction Shutter Mean Median StdDev AmbientTemperature Humidity/;
    my @values = (
        $Frm->subarray($i + 1),
        ($Frm->uhdr('FTS_SCANDIR_ZPD')
         ? ($Frm->hdrval('SCANDIR', $i) > 0 ? 'Forward' : 'Backward')
         : 'Any'),
        ($Frm->uhdr('FTS_ZPD_SHUTTER') // '*****'),
        $_FIND_IMAGE_STATISTICS_{'RESULTS'}->{'MEAN'},
        $_FIND_IMAGE_STATISTICS_{'RESULTS'}->{'MEDIAN'},
        $_FIND_IMAGE_STATISTICS_{'RESULTS'}->{'SIGMA'},
        $Frm->uhdr('ORAC_AMBIENT_TEMPERATURE') // '*****',
        $Frm->uhdr('ORAC_HUMIDITY') // '*****',
    );
    my @units = ('', '', '', 'mm', 'mm', 'mm', 'degC', '%');
    my $efmt = '%8s %9s %7s %6.3f %6.3f %6.3f             %6.1f   %6.1f';
    my $pfmt = '%8s %9s %7s %6s %6s %6s %18s %8s';

    _ADD_LOG_ENTRY_ LOGFILE=zeropath ENTRIES=\@values PARAMS=\@headings UNITS=\@units ENTRY_FORMAT=$efmt PARAM_FORMAT=$pfmt
}
