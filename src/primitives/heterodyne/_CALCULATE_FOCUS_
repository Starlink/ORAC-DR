my $type = uc get_prim_arg($_PRIM_ARGS_, 'TYPE', 'LINE');

my $in = $Frm->file;

_GET_DIMENSIONS_ FILE=$in
my $flbound = $_GET_DIMENSIONS_{'FLBOUND'};
my $fubound = $_GET_DIMENSIONS_{'FUBOUND'};

$Mon{'ndfpack_mon'}->obeyw('setaxis', "ndf=$in dim=1 mode=wcs");
my $FitStatus = $Mon{'figaro4'}->obeyw('fitpoly', "in=$in device=! mask1=$flbound->[0] mask2=$fubound->[0] order=2 comp=0 logfil=! dialog=f varuse=f");

unless ($FitStatus == ORAC__OK) {
    orac_err("Error fitting parabola to focus data.\n");
}
else {
    (my $ORAC_STATUS, my @coeffs) = $Mon{'figaro4'}->get('fitpoly', 'fitcoeffs');

    if ($coeffs[2] >= 0.0) {
        orac_say('No maximum found in parabola fitted to focus results.');
    }
    else {
        my $off = - $coeffs[1] / (2.0 * $coeffs[2]);
        my $axis = $Frm->hdr('FOCAXIS');

        my $cache = $Frm->uhdr('FOCUS_INFO');
        $Frm->uhdr('FOCUS_INFO', $cache = []) unless defined $cache;
        push @$cache, {
            AXIS => $axis,
            TYPE => $type,
            OFFSET => $off,
        };

        my $log = ORAC::LogFile->new('log.focus');
        $log->header(
            'Pointing log file - created on ' . gmtime,
            '',
            '#    Time        Axis Offset Type',
            '-------------------------------------',
        );
        $log->addentry(sprintf "%-4d %11.2f %4s %6.2f %s",
            $Frm->number,
            $Frm->hdr('ORACTIME'),
            $axis,
            $off,
            (lc $type));
    }

    my $expand = ORAC::TempFile->new(0);
    $Mon{'kappa_mon'}->obeyw('sqorst', "in=$in out=$expand mode=factors factors=[10] method=linear");

    my $model = $in . '_model';
    $Mon{'figaro4'}->obeyw('evalfit', "in=$expand out=$model comp=1 noreply");
    $Mon{'ndfpack_mon'}->obeyw('wcscopy', "ndf=$model like=$expand");
    $Frm->push_intermediates($model);

    $Display->display_data($Frm);
}
