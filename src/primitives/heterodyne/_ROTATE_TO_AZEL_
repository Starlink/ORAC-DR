my $suffix = get_prim_arg($_PRIM_ARGS_, 'SUFFIX', 'azel');

my ($in, $out) = $Frm->inout('_' . $suffix);

# Scale up the input file using sqorst and set its system to AzEl.
my $sq = ORAC::TempFile->new(0);
$Mon{'kappa_mon'}->obeyw('sqorst', "in=$in out=$sq mode=factors factors=[20,20,1] method=nearest");
$Mon{'ndfpack_mon'}->obeyw('wcsattrib', "ndf=$sq mode=set name=system newval=AzEl");

# Determine angle from upright using astRate.
$Mon{'atools_mon'}->obeyw('astrate', "this=$sq at=[0,0,0] ax1=1 ax2=1");
my ($ORAC_STATUS, $dx) = $Mon{'atools_mon'}->get('astrate', 'rate');
$Mon{'atools_mon'}->obeyw('astrate', "this=$sq at=[0,0,0] ax1=1 ax2=2");
($ORAC_STATUS, my $dy) = $Mon{'atools_mon'}->get('astrate', 'rate');
my $angle = atan2($dy, $dx) * DR2D;

# Apply the rotation to generate the output file.
$Mon{'kappa_mon'}->obeyw('rotate', "angle=$angle in=$sq out=$out");

$Frm->file($out);
$Display->display_data($Frm);
