# Handle arguments.
my $cache = get_prim_arg($_PRIM_ARGS_, 'CACHE', 0);
my $report = get_prim_arg($_PRIM_ARGS_, 'REPORT', 1);
my $type = uc get_prim_arg($_PRIM_ARGS_, 'TYPE', 'LINE');

my $have_jcmt_pointing = eval {require JCMT::Pointing; 1;};

my $store_pointing_result = sub {
  my ($xcen, $ycen, $xerr, $yerr, $method, $file) = @_;

  if ($report) {
    # Make them pretty for output.
    my $p_xcen = sprintf "%.2f", $xcen;
    my $p_ycen = sprintf "%.2f", $ycen;

    # Display the results to the user.
    orac_say( "Pointing results using $method", "blue" );
    if (defined $xerr and defined $yerr) {
      my $p_xerr = sprintf "%.2f", $xerr;
      my $p_yerr = sprintf "%.2f", $yerr;
      orac_say( " DAZ: $p_xcen +/- $p_xerr\n DEL: $p_ycen +/- $p_yerr", "blue" );
    }
    else {
      orac_say( " DAZ: $p_xcen\n DEL: $p_ycen", "blue" );
    }

    # Display a warning if values are large.
    if( abs( $xcen ) > 10 ) {
      orac_err "Absolute DAZ pointing value greater than 10 arcseconds.\n";
    } elsif( abs( $xcen ) > 5 ) {
      orac_warn "Absolute DAZ pointing value greater than 5 arcseconds.\n";
    }
    if( abs( $ycen ) > 10 ) {
      orac_err "Absolute DEL pointing value greater than 10 arcseconds.\n";
    } elsif( abs( $ycen ) > 5 ) {
      orac_warn "Absolute DEL pointing value greater than 5 arcseconds.\n";
    }

    orac_say "";
  }

  # Store with the calibration system.
  my %pointing = (
    DAZ => $xcen,
    DEL => $ycen,
    DAZ_ERR => $xerr // 0,
    DEL_ERR => $yerr // 0,
    POINTING_TYPE => $type,
    METHOD => uc $method,
  );

  my %calhash = (%{$Frm->hdr}, %pointing);
  $Cal->pointingindex->add( $Frm->file, \%calhash );

  # Get initial UAZ, UEL values from the header (before pointing) in order
  # to be able to estimate the total offset afterwards (UAZ + DAZ), etc.
  my $uaz_start = $Frm->hdr('UAZ') // 0.0;
  my $uel_start = $Frm->hdr('UEL') // 0.0;

  my $rot_st = $Frm->hdr('ROT_IAST');
  my $rot_en = $Frm->hdr('ROT_IAEN');
  my $rot_angle = ((defined $rot_st) and (defined $rot_en))
    ? (($rot_st + $rot_en) / 2.0)
    : 0;

  # Start a log file.
  my $log = ORAC::LogFile->new('log.pointing');
  my $time = gmtime();
  $log->header(
    "Pointing log file - created on $time\n",
    "#    Time         DAZ    DEL   Method    Type      UAZ    UEL    IMG_ANG",
    "------------------------------------------------------------------------");

  $log->addentry(sprintf "%-4d %11.2f %6.2f %6.2f %-9s %-9s %6.2f %6.2f %7.2f",
    $Frm->number,
    $Frm->hdr('ORACTIME'),
    $xcen,
    $ycen,
    $method,
    (lc $type),
    ($uaz_start + $xcen),
    ($uel_start + $ycen),
    $rot_angle);

  if ($cache) {
    unless (defined $Frm->uhdr("POINTING_INFO")) {
      $Frm->uhdr("POINTING_INFO", []);
    }
    my $pointing_info = $Frm->uhdr("POINTING_INFO");
    push @$pointing_info, \%pointing;
  }

  # Store this fit in the file.
  if ($have_jcmt_pointing) {
    my @fit;
    push @fit, JCMT::Pointing::Fit->new(
        label => "$method-$type",
        offset => Astro::Coords::Offset->new(
            $xcen, $ycen,
            system => 'AZEL'));
    JCMT::Pointing->append_fit_to_datafile( $file, @fit );
  }
};


if( ! $Frm->uhdr( "SPARSE_CUBE" ) ) {

  my $in = $Frm->file;

  # Check the JIGL_CNT header. If it's five or smaller, then do the
  # fivepoint pointing calculation. We don't check for equality to
  # five because of a bug in ACSIS's data handling system that can
  # throw off the JIGL_CNT header. We've seen that it can be 4 for a
  # fivepoint, but checking for fewer than six seems to be safer.
  my $jiggle_count = defined( $Frm->hdr( "JIGL_CNT" ) ) ? $Frm->hdr( "JIGL_CNT" ) : 5;
  if( $jiggle_count <= 5 ) {

    _CALCULATE_FIVEPOINT_POINTING_

    my $result = $_CALCULATE_FIVEPOINT_POINTING_{'RESULT'};

    if (defined $result) {
      $store_pointing_result->(
        @$result, 0, 0, 'fivepoint', $in);
    }

  } else {

    # Read the reference WCS so that we can work out how to reset the frameset
    # after we have called centroid
    my $wcs = $Frm->read_wcs( $in );

    # Set the offset coordinate system to Origin and the formatting of axes to arcseconds
    # with 4 decimal places
    my $newformat = "s.4";
    $Mon{ndfpack_mon}->obeyw("wcsattrib", "ndf=$in mode=mset setting='System=AzEl,SkyRefIs=Origin,Format(1)=$newformat,Format(2)=$newformat'");

    # Calculate the centroid, using the centre of the array as the
    # initial position of the object.
    my $params = "ndf=$in init='0,0' mode=Interface cerror maxshift=26";
    $Mon{'kappa_mon'}->obeyw( "centroid", "$params" );

    # Retrieve the x and y centre.
    ( my $ORAC_STATUS, my $cen_xcen ) = $Mon{'kappa_mon'}->get( "centroid", "xcen" );
    ( $ORAC_STATUS, my $cen_ycen ) = $Mon{'kappa_mon'}->get( "centroid", "ycen" );
    ( $ORAC_STATUS, my $cen_xerr ) = $Mon{'kappa_mon'}->get( "centroid", "xerr" );
    ( $ORAC_STATUS, my $cen_yerr ) = $Mon{'kappa_mon'}->get( "centroid", "yerr" );

    $store_pointing_result->(
      $cen_xcen, $cen_ycen, $cen_xerr, $cen_yerr, 'centroid', $in);

    # Now do the PSF pointing calculation.
    #
    # Find the location of the peak pixel.
    $Mon{'ndfpack_mon'}->obeyw( "setaxis", "ndf=$in mode=wcs dim=1" );
    $Mon{'ndfpack_mon'}->obeyw( "setaxis", "ndf=$in mode=wcs dim=2" );
    $Mon{'kappa_mon'}->obeyw( "stats", "ndf=$in" );
    ( $ORAC_STATUS, my @maxcoord ) = $Mon{'kappa_mon'}->get( "stats", "maxcoord" );
    ($ORAC_STATUS, my $maxwcs) = $Mon{'kappa_mon'}->get('stats', 'maxwcs');
    my $x_max = $maxcoord[0] * 3600;
    my $y_max = $maxcoord[1] * 3600;

    # Create an input positions list file.
    my $psfcat = new ORAC::TempFile;
    my $psfcatfile = $psfcat->file;
    open(my $psfcatfile_h, ">", $psfcatfile)
        or orac_throw "Cannot open temporary file for writing PSF input position list: $!";
    printf($psfcatfile_h "%.6f %.6f\n",$x_max, $y_max);
    close $psfcatfile_h;

    # Set up the parameters for PSF.
    $params = "in=$in incat=! cofile=$psfcatfile device=! gauss=false out=!";

    # Run PSF.
    my $PSF_STATUS = $Mon{'kappa_mon'}->obeyw( "psf", "$params" );

    # Integer error code for known bad conditions
    if ( $PSF_STATUS == 257327122   # KAP__PSFSN
        || $PSF_STATUS == 257327130 # KAP__PSFNO
        ) {
      orac_warn "Unable to fit a PSF profile in the current image\n"
    } elsif ($PSF_STATUS == ORAC__OK) {

      # Retrieve the position.
      ( $ORAC_STATUS, my $psf_xcen ) = $Mon{'kappa_mon'}->get( "psf", "xcen" );
      ( $ORAC_STATUS, my $psf_ycen ) = $Mon{'kappa_mon'}->get( "psf", "ycen" );

      $store_pointing_result->(
        $psf_xcen, $psf_ycen, undef, undef, 'psf', $in);

    } else {
      # some untrappable error
      $ORAC_STATUS = $PSF_STATUS;
    }

    $maxwcs =~ s/,//g;
    my @maxwcs = split /\s+/, $maxwcs;
    my $BF_STATUS = $Mon{'kappa_mon'}->obeyw('beamfit', "ndf=$in mode=interface pos=\"$maxwcs[0],$maxwcs[1]\" beams=1 fwhm=15");

    unless ($BF_STATUS == ORAC__OK) {
      orac_warn "Unable to fit pointing source using beamfit\n";
    }
    else {
      ($ORAC_STATUS, my @bf_cen) = $Mon{'kappa_mon'}->get('beamfit', 'centre');

      $store_pointing_result->(
        (split /\s+/, $bf_cen[0], 2),
        (split /\s+/, $bf_cen[1], 2),
        'beamfit', $in);
    }

    # Set System, SkyRefIs and Format back to what they were before.
    my $system = $wcs->Get("System(1)");
    my $skyrefis = $wcs->Get("SkyRefIs");
    my $format1 = $wcs->Get("Format(1)");
    my $format2 = $wcs->Get("Format(2)");

    $Mon{'ndfpack_mon'}->obeyw( "wcsattrib", "ndf=$in mode=mset setting='System=$system,SkyRefIs=$skyrefis,Format(1)=$format1,Format(2)=$format2'" );

    # Tidy-up output.
    orac_say "";

  }

} else {

  orac_say "Currently unable to calculate pointing values for a sparse cube.";

  # Tidy-up output.
  orac_say "";

}

