my $instap = ( defined( $Frm->hdr( "INSTAP" ) ) ?
               uc( $Frm->hdr( "INSTAP" ) )      :
               '' );

my %return_hash = ();

# Force rotation angle to 0 and turn off autogrid.
$return_hash{'autogrid'} = 'no';
$return_hash{'crota'} = 0;

# Check if we're doing a specific detector.
if( $instap ne '' ) {
  $return_hash{'detectors'} = $instap;
}

# Always force system=tracking and alignsys=true.
$return_hash{'system'} = 'tracking';
$return_hash{'alignsys'} = 'true';

my $jig_name = $Frm->hdr('JIGL_NAM');
if ((defined $jig_name) and ($jig_name =~ /harp([45])/i)) {
  # We have a fixed HARP jiggle pattern (which doesn't use scaling).
  # Therefore we need to use the appropriate pixel scale (taken from
  # _GET_MAKECUBE_PARAMS_ routine for type JIGGLE.
  $return_hash{'pixsize'} = $1 == 4 ? 7.5 : 6;
}
else {
  # Check to see if we have a JIG_SCAL header defined. If so, then we
  # can force the pixel scale to that.
  my $jig_scale = $Frm->hdr('JIG_SCAL');
  if ((defined $jig_scale) and ($jig_scale ne '')) {
    $return_hash{'pixsize'} = $jig_scale;
  }
}

# Return.
$_PRIM_ARGS_->{HASH} = \%return_hash;
