# Handle parameters.
my $type = get_prim_arg( $_PRIM_ARGS_, "TYPE", undef, 1 );
$type = uc( $type );

my $system = get_prim_arg($_PRIM_ARGS_, 'SYSTEM', undef);

my $file = $Frm->file;

orac_print "Determining MAKECUBE parameters for $type for $file.\n";

# Set up some defaults.
my %return_hash = ( 'system' => ($system // 'tracking'),
                    'autogrid' => 'yes',
                    'badmask' => 'and',
                    'alignsys' => 'yes',
                    'usedetpos' => 'no',
                    'poserrfatal' => 'yes',
                  );

if( $type eq 'RASTER' or $type eq 'SCAN' ) {

  $return_hash{'sparse'} = 'no';

  # We get the pixel scale by multiplying SCAN_VEL and STEPTIME headers,
  # and the position angle comes from the MAP_PA header. Force the
  # position angle to be between -45 and 45 degrees. Set the system to
  # azel if the LOCL_CRD header is AZEL.
  my $pixsize = $Frm->hdr( "SCAN_VEL" ) * $Frm->hdr( "STEPTIME" );
  my $crota = - $Frm->hdr( "MAP_PA" );
  while ( $crota < -45 || $crota > 45 ) {
    if( $crota < -45 ) {
      $crota += 90;
    } elsif( $crota > 45 ) {
      $crota -= 90;
    }
  }

  $return_hash{'pixsize'} = $pixsize;
  $return_hash{'crota'} = $crota;

  # If we SCANned in AZEL, then set the system to AZEL,
  # unless a sytem was explicity specified.
  if ((not defined $system) and ('AZEL' eq uc $Frm->hdr('LOCL_CRD'))) {
    $return_hash{'system'} = 'azel';
  }

} elsif( $type eq 'JIGGLE' ) {

  # JIGGLEs always use autogrid.
  $return_hash{'autogrid'} = 'yes';
  $return_hash{'usedetpos'} = 'no';

  # HARP4 and HARP5 jiggles get their pixel scale set to 7.5 or 6,
  # respectively.
  my $jiggle_name = ( defined( $Frm->hdr( "JIGL_NAM" ) ) ?
                      $Frm->hdr( "JIGL_NAM" )            :
                      "" );
  if( $jiggle_name =~ /harp([45])/i ) {
    my $pixsize = ( $1 == 4 ? 7.5 : 6 );
    $return_hash{'pixsize'} = $pixsize;
  }

} elsif( $type eq 'GRID' ) {

  # GRIDs just use autogrid.
  $return_hash{'autogrid'} = 'yes';
  $return_hash{'usedetpos'} = 'no';

} elsif( $type eq 'POINTING' or $type eq 'FOCUS' ) {

  my $instap = ( defined( $Frm->hdr( "INSTAP" ) ) ?
                 uc( $Frm->hdr( "INSTAP" ) )      :
                 '' );

  # Force rotation angle to 0 and turn off autogrid.
  $return_hash{'autogrid'} = 'no';
  $return_hash{'crota'} = 0;

  # Check if we're doing a specific detector.
  if( $instap ne '' ) {
    $return_hash{'detectors'} = $instap;
  }

  # Always force system=azel or tracking (unless specified) and alignsys=true.
  unless (defined $system) {
    my $jig_crd = uc $Frm->hdr('JIG_CRD');
    if ($jig_crd eq 'FPLANE') {
      # This is likely HARP pointing, performed in focal plane coordinates
      # with the K-mirror tracking the source -- grid in tracking coordinates.
      $return_hash{'system'} = 'tracking';
      $Frm->uhdr('POINTING_IS_AZEL', 0);
    }
    else {
      unless ($jig_crd eq 'AZEL') {
        orac_warn("Unexpected jiggle coordinate system '$jig_crd', gridding in Az-El.\n");
      }
      $return_hash{'system'} = 'azel';
      $Frm->uhdr('POINTING_IS_AZEL', 1);
    }
  }
  else {
      $Frm->uhdr('POINTING_IS_AZEL', ('AZEL' eq uc $system) ? 1 : 0);
  }
  $return_hash{'alignsys'} = 'true';

  my $jig_name = $Frm->hdr('JIGL_NAM');
  if ((defined $jig_name) and ($jig_name =~ /harp([45])/i)) {
    # We have a fixed HARP jiggle pattern (which doesn't use scaling).
    # Therefore we need to use the appropriate pixel scale (taken from
    # the routine for type JIGGLE).
    $return_hash{'pixsize'} = $1 == 4 ? 7.5 : 6;
  }
  else {
    # Check to see if we have a JIG_SCAL header defined. If so, then we
    # can force the pixel scale to that.
    my $jig_scale = $Frm->hdr('JIG_SCAL');
    if ((defined $jig_scale) and ($jig_scale ne '')) {
      $return_hash{'pixsize'} = $jig_scale;
    }
  }

} else {
  orac_throw "Unable to determine MAKECUBE parameters for observation type $type."
}

# Override USEDETPOS for RxW.
if( $Frm->uhdr( "ORAC_INSTRUMENT" ) =~ /rxw/i ) {
  $return_hash{'usedetpos'} = "yes";
}

# And set the return value.
$_PRIM_ARGS_->{'PARAMS'} = \%return_hash;
