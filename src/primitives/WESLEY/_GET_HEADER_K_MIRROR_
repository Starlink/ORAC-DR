use JCMT::HARP_K_Mirror;
use Astro::Coords;
use Astro::Telescope;
use DateTime::Format::ISO8601;

for (my $i = 0; $i < $Frm->nfiles(); $i ++) {
    my $in = $Frm->file($i + 1);
    my $ia_st_hdr = $Frm->hdrval('ROT_IAST', $i);
    my $ia_en_hdr = $Frm->hdrval('ROT_IAEN', $i);

    unless ((defined $ia_st_hdr) and (defined $ia_en_hdr)) {
        die 'TRACKSYS is not J2000'
            unless 'J2000' eq $Frm->hdrval('TRACKSYS', $i);

        my $coord = Astro::Coords->new(
           ra => $Frm->hdrval('BASEC1', $i),
           dec => $Frm->hdrval('BASEC2', $i),
           type => 'J2000',
           units => 'degrees');

        $coord->telescope(Astro::Telescope->new('JCMT'));

        my $angle = $Frm->hdrval('ROT_PA', $i);

        foreach my $hdrinfo (
                ['DATE-OBS', 'ROT_IAST', $ia_st_hdr],
                ['DATE-END', 'ROT_IAEN', $ia_en_hdr]) {
            my ($hdr_dt, $hdr_angle, $val_angle) = @$hdrinfo;
            next if defined $val_angle;

            my $date = $Frm->hdrval($hdr_dt, $i);
            my $dt = DateTime::Format::ISO8601->parse_datetime($date);
            $coord->datetime($dt);

            # Specify PA=0 as the translator should have already included
            # this in the choices for ROT_PA.
            my $kmirror = JCMT::HARP_K_Mirror::get_kmirror_angle($coord, 0);

            my $beam = $kmirror + $angle;

            $beam += 360.0 while $beam <= -180.0;
            $beam -= 360.0 while $beam > 180.0;

            $Frm->uhdr()->{'WESLEY_SET_HEADERS'}->{$in}->{$hdr_angle} = $beam;
        }
    }
}
