use Astro::PAL qw/:constants/;

my $column = ['TCS_TR_ANG', 'TCS_AZ_ANG', 'TCS_AZ_BC2'];

for (my $i = 0; $i < $Frm->nfiles(); $i ++) {
    my $in = $Frm->file($i + 1);
    my $ia_st_hdr = $Frm->hdrval('ROT_IAST', $i);
    my $ia_en_hdr = $Frm->hdrval('ROT_IAEN', $i);

    unless ((defined $ia_st_hdr) and (defined $ia_en_hdr)) {
        my $angle = $Frm->hdrval('ROT_PA', $i);

        _READ_JCMT_STATE_ FILE=$in COLUMN=$column
        my $state = $_READ_JCMT_STATE_{'STATE'};

        foreach my $hdrinfo (
                ['ROT_IAST', $ia_st_hdr, 0],
                ['ROT_IAEN', $ia_en_hdr, -1]) {
            my ($hdr_angle, $val_angle, $element) = @$hdrinfo;
            next if defined $val_angle;

            my $el = $state->{'TCS_AZ_BC2'}->[$element] * DR2D;
            my $pa = ($state->{'TCS_AZ_ANG'}->[$element]
                - $state->{'TCS_TR_ANG'}->[$element]) * DR2D;

            my $kmirror = $el - $pa;

            my $beam = $kmirror + $angle;

            $beam += 360.0 while $beam <= -180.0;
            $beam -= 360.0 while $beam > 180.0;

            $Frm->uhdr()->{'WESLEY_SET_HEADERS'}->{$in}->{$hdr_angle} = $beam;
        }
    }
}
