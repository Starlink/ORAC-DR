use NDF;

my $filename = get_prim_arg($_PRIM_ARGS_, 'FILE', undef);
my $extensions = get_prim_arg($_PRIM_ARGS_, 'EXTENSION', undef);

my $reshape_array; $reshape_array = sub {
    my $val = shift;
    my @dims = @_;

    my $dim = shift @dims;
    return $val unless @dims;

    my $nelem = $dim;
    $nelem *= $_ foreach @dims;

    return [map {
        my $i = $_;
        my @val = ();
        for (my $j = $i; $j < $nelem; $j += $dim) {
            push @val, $val->[$j];
        }
        $reshape_array->(\@val, @dims)
    } 0 .. ($dim - 1)];
};

my $read_extension; $read_extension = sub {
    my $eloc = shift;
    my $status = shift;

    return undef unless $$status == &NDF::SAI__OK();

    my %extension = ();

    dat_ncomp($eloc, my $ncomp, $$status);
    for (my $i = 1; ($i <= $ncomp) && ($$status == &NDF::SAI__OK()); $i ++) {
        dat_index($eloc, $i, my $iloc, $$status);
        dat_name($iloc, my $name, $$status);

        dat_struc($iloc, my $struct, $$status);
        if ($struct) {
            $extension{$name} = $read_extension->($iloc, $status);
        }
        else {
            dat_type($iloc, my $type, $$status);
            dat_size($iloc, my $size, $$status);
            dat_shape($iloc, 7, my @dims, my $ndim, $$status);
            my @val;

            if ($type =~ /^_REAL/) {
                dat_getvr($iloc, $size, @val, my $size, $$status);
                for (my $i = 0; $i < $size; $i ++) {
                    undef $val[$i] if $val[$i] == &NDF::VAL__BADR();
                }
            }
            elsif ($type =~ /^_DOUBLE/) {
                dat_getvd($iloc, $size, @val, my $size, $$status);
                for (my $i = 0; $i < $size; $i ++) {
                    undef $val[$i] if $val[$i] == &NDF::VAL__BADD();
                }
            }
            elsif ($type =~ /^_INTEGER/) {
                dat_getvi($iloc, $size, @val, my $size, $$status);
                for (my $i = 0; $i < $size; $i ++) {
                    undef $val[$i] if $val[$i] == &NDF::VAL__BADI();
                }
            }
            else {
                dat_getvc($iloc, $size, @val, my $size, $$status);
            }

            $extension{$name} = ($ndim == 0)
                    ? $val[0]
                    : $reshape_array->(\@val, @dims);
        }

        dat_annul($iloc, $$status);
    }

    return \%extension;
};

do {
    my @extensions = ();
    unless (defined $extensions) {
        orac_throw('Extension name(s) not specified');
    }
    elsif (ref $extensions) {
        @extensions = @$extensions;
    }
    else {
        @extensions = split /,/, $extensions;
    }

    my $status = &NDF::SAI__OK();
    err_begin($status);
    hds_open($filename, 'READ', my $loc, $status);
    dat_find($loc, 'MORE', my $mloc, $status);

    foreach my $extension (@extensions) {
        dat_find($mloc, $extension, my $eloc, $status);

        $_READ_EXTENSION_{$extension} = $read_extension->($eloc, \$status);

        dat_annul($eloc, $status);
    }

    dat_annul($mloc, $status);
    dat_annul($loc, $status);
    my $errstr = undef;
    if ($status != &NDF::SAI__OK()) {
        $errstr = &NDF::err_flush_to_string($status);
    }
    err_end($status);

    orac_throw("Could not read extension: $errstr") if defined $errstr;
};
