use Astro::Coords;
use Astro::Coords::Angle;
use Astro::Coords::Offset;
use Astro::Telescope;

my $daz = get_prim_arg($_PRIM_ARGS_, 'DAZ', undef);
my $del = get_prim_arg($_PRIM_ARGS_, 'DEL', undef);

# Extract basic information from headers.
my $az_st = $Frm->hdrval('AZSTART', 0);
my $az_en = $Frm->hdrval('AZEND', -1);

my $el_st = $Frm->hdrval('ELSTART', 0);
my $el_en = $Frm->hdrval('ELEND', -1);

# Get initial UAZ, UEL values from the header (before pointing) in order
# to be able to estimate the total offset afterwards (e.g. UAZ + DAZ).
my $uaz_start = $Frm->hdrval('UAZ', 0) // 0.0;
my $uel_start = $Frm->hdrval('UEL', 0) // 0.0;

my $az = undef;
if ((defined $az_st) and (defined $az_en)) {
    $az = ($az_st + $az_en) / 2.0;
}

my $el = undef;
if ((defined $el_st) and (defined $el_en)) {
    $el = ($el_st + $el_en) / 2.0;
}

my $dt_st = $Frm->uhdr('ORAC_UTSTART');

# Prepare pointing log information.
my $uaz = undef;
if (defined $daz) {
    $uaz = $uaz_start + $daz;
}

my $uel = undef;
if (defined $del) {
    $uel = $uel_start + $del;
}

my $ura = undef;
my $udec = undef;
if ((defined $uaz) and (defined $uel)
        and (defined $az_st) and (defined $el_st) and (defined $dt_st)) {
    my $coord = Astro::Coords->new(az => $az_st, el => $el_st);

    my $telescope = Astro::Telescope->new('JCMT');
    $coord->telescope($telescope);
    $coord->datetime($dt_st);

    my $offset = Astro::Coords::Offset->new(- $uaz, $uel, posang => $coord->pa());
    ($ura, $udec) = map {$_->arcsec()} $offset->offsets_rotated();
}

# Return a hash via primitive parameter 'INFO'.
$_PRIM_ARGS_->{'INFO'} = {
    AZ => $az,
    EL => $el,
    UAZ => $uaz,
    UEL => $uel,
    URA => $ura,
    UDEC => $udec,
};
