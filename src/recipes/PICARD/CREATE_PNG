=cut

my $resolution = $RECPARS{'RESOLUTION'} // 256;
my $fixedhigh = $RECPARS{'FIXEDHIGH'};
my $fixedlow = $RECPARS{'FIXEDLOW'};
my $sighigh = $RECPARS{'SIGHIGH'};
my $siglow = $RECPARS{'SIGLOW'};
my $extension = $RECPARS{'EXTENSION'};
my $suffix = $RECPARS{'SUFFIX'};


if (defined $extension) {
  $suffix = '_' . $suffix if ((defined $suffix) and not ($suffix =~ /^_/));

  _EXTRACT_EXTENSION_ EXTENSION=$extension SUFFIX=$suffix
}

foreach my $file ( $Frm->files ) {
  _CREATE_GRAPHIC_FROM_FILE_ FILE=$file TYPE=PNG ADDRES=1 XRES=$resolution FIXEDHIGH=$fixedhigh FIXEDLOW=$fixedlow SIGHIGH=$sighigh SIGLOW=$siglow
}

_DELETE_TEMP_FILES_ KEEP=_nothing
