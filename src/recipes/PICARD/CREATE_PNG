=cut

my $resolution = $RECPARS{'RESOLUTION'} // 256;

foreach my $file ( $Frm->files ) {

  _CREATE_GRAPHIC_FROM_FILE_ FILE=$file TYPE=PNG ADDRES=1 XRES=$resolution

}
