# Individual observations.
cube001    tool=gaia type=image region=0 window=0 autoscale=1 zautoscale=1
reduced001 tool=gaia type=image region=0 window=1 autoscale=1 zautoscale=1

rimg    tool=kapview type=image region=1 window=0 xautoscale=1 yautoscale=1 zautoscale=1
rsp     tool=kapview type=graph region=2 window=0 xautoscale=1 yautoscale=1 3autoscale=1 errbar=0 cut=3

# Pointing observations.
linteg001 tool=kapview type=image region=5 window=1 xautoscale=1 yautoscale=1 zautoscale=1 lut=grey badcol=black
lintegrot tool=kapview type=image region=5 window=1 xautoscale=1 yautoscale=1 zautoscale=1 lut=grey badcol=black
cont    tool=kapview type=image region=6 window=1 xautoscale=1 yautoscale=1 zautoscale=1 lut=grey badcol=black
controt tool=kapview type=image region=6 window=1 xautoscale=1 yautoscale=1 zautoscale=1 lut=grey badcol=black
pntcube tool=kapview type=graph region=0 window=2 multiline=1 absaxis=2
linteg001hori tool=kapview type=datamodel region=1 window=0 xautoscale=1
linteg001vert tool=kapview type=datamodel region=3 window=0 xautoscale=1
conthori tool=kapview type=datamodel region=2 window=0 xautoscale=1
contvert tool=kapview type=datamodel region=4 window=0 xautoscale=1

# Focus observations.
foclint001 tool=kapview type=datamodel region=5 window=1 xautoscale=1 zautoscale=1
foccont tool=kapview type=datamodel region=6 window=1 xautoscale=1 zautoscale=1
foccube tool=kapview type=graph region=0 window=2 multiline=1 absaxis=1

# Group observations.
g_rimg tool=kapview type=image region=3 window=0 xautoscale=1 yautoscale=1 zautoscale=1
g_rsp  tool=kapview type=graph region=4 window=0 xautoscale=1 yautoscale=1 3autoscale=1 errbar=0 cut=3
g_reduced001 tool=gaia type=image region=0 window=1 autoscale=1 zautoscale=1
